# Shakti production — скопировать в docker/.env.shakti на сервере (не коммитить)

UID=1000
GID=1000

POSTGRES_DB=os3
POSTGRES_USER=os3
POSTGRES_PASSWORD=change-me-generate-strong

APP_DOMAIN=acts.os3.pro
TZ=Europe/Moscow

# Traefik Let's Encrypt (docker/traefik/.env на сервере)
ACME_EMAIL=admin@os3.pro
