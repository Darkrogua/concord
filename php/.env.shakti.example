# Shakti production — скопировать в php/.env на сервере.
# DB и APP_URL задаются через docker-compose.shakti.yaml; здесь — ключ и локальные override.

APP_NAME="OS3"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://acts.os3.pro
APP_LOCALE=ru
APP_FALLBACK_LOCALE=ru

ACTIVE_THEME=os3
BACKEND_URI=console

DB_CONNECTION=pgsql
DB_HOST=os3-db
DB_PORT=5432
DB_DATABASE=os3
DB_USERNAME=os3
DB_PASSWORD=change-me-same-as-docker-env

LOG_CHANNEL=single
CACHE_STORE=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=none

MAIL_MAILER=log
